# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────────────
# Defaults to ./data.db next to server.js. On Railway, set this to a path
# inside a persistent volume, e.g. /data/agentic-shelf.db
DB_PATH=./data.db

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave blank in development — Ethereal fake SMTP is used automatically.
# For production, fill these in (Resend, Postmark, SendGrid, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Agentic Shelf" <noreply@agenticshelf.com>

# ─── AI measurement API keys (optional — simulation runs without these) ───────
# Add keys to enable real AI query measurements instead of simulation scores.
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
